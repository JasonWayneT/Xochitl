# Xochitl environment variables
# Copy to .env and fill in values, or use `xochitl secrets set KEY value`.
# Secrets load order: SQLite secret store -> env var -> default (see src/secrets.py).

# -- Local LLM (Ollama / LM Studio) --
LOCAL_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
LOCAL_MODEL=phi3.5:3.8b-mini-instruct-q8_0
LOCAL_THINKING_MODEL=phi4:14b-q4_K_M
LOCAL_CODING_MODEL=qwen2.5-coder:14b-instruct-q4_K_M
ROUTER_MODEL=gemma2:2b
LM_STUDIO_URL=http://localhost:1234/v1

# -- Cloud LLM --
CLOUD_PROVIDER=gemini
CLOUD_MODEL=gemini-2.0-flash
CLOUD_MODEL_PRO=gemini-2.0-flash
CLOUD_MODEL_FLASH=gemini-2.0-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# -- Notion integration --
NOTION_API_KEY=
NOTION_PROJECTS_DB_ID=
NOTION_AREAS_DB_ID=
NOTION_TASKS_DB_ID=
NOTION_RESOURCES_DB_ID=

# -- Zettelkasten vault --
VAULT_PATH=

# -- Session token budget governor (estimated tokens) --
XCH_PREFER_LOCAL_TOKENS=20000
XCH_LOCAL_ONLY_TOKENS=40000
XCH_HARD_STOP_TOKENS=80000

# -- Ollama server tuning (set via scripts/start_ollama.ps1 on Windows) --
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_NUM_PARALLEL=2
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
# OLLAMA_MAX_LOADED_MODELS=2
